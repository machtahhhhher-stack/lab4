<mxfile host="app.diagrams.net"><diagram name="Схема бота" id="bot"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="Схема работы Telegram-бота «Фильмы»" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="b2" value="Пользователь&lt;br&gt;(Telegram)" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="150" height="60" as="geometry"/></mxCell><mxCell id="b3" value="Серверы Telegram&lt;br&gt;(Bot API)" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="140" width="150" height="60" as="geometry"/></mxCell><mxCell id="b4" value="Программа bot.py (aiogram, работает на компьютере)" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontColor=#666666;html=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="430" y="50" width="420" height="430" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Dispatcher&lt;/b&gt; — получает обновления (long polling)&lt;br&gt;и выбирает обработчик" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="450" y="80" width="380" height="60" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;handlers.py&lt;/b&gt; — обработчики:&lt;br&gt;команды /start /search /top /random /favorites /history /settings,&lt;br&gt;текст = поиск, кнопки film: fav: set: find:,&lt;br&gt;обработчик ошибок.&lt;br&gt;&lt;br&gt;Ответы оформляют &lt;b&gt;texts.py&lt;/b&gt; (текст) и &lt;b&gt;keyboards.py&lt;/b&gt; (кнопки)" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="380" height="150" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;storage.py&lt;/b&gt;&lt;br&gt;UserStore, UserSettings" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="450" y="395" width="180" height="60" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;api.py&lt;/b&gt; — MovieApi&lt;br&gt;(aiohttp)" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="650" y="395" width="180" height="60" as="geometry"/></mxCell><mxCell id="b9" value="users.json&lt;br&gt;настройки пользователей" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;shape=note;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="450" y="500" width="180" height="50" as="geometry"/></mxCell><mxCell id="b10" value="Викиданные API&lt;br&gt;поиск, факты, оценки" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="910" y="330" width="170" height="50" as="geometry"/></mxCell><mxCell id="b11" value="Википедия REST API&lt;br&gt;описание, постер" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="910" y="400" width="170" height="50" as="geometry"/></mxCell><mxCell id="b12" value="iTunes RSS&lt;br&gt;топ продаж" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="910" y="470" width="170" height="50" as="geometry"/></mxCell><mxCell id="e13" value="сообщения,&lt;br&gt;нажатия кнопок" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;startArrow=block;startFill=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="getUpdates /&lt;br&gt;sendMessage" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;startArrow=block;startFill=1;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="настройки" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="данные о фильмах" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b6" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="чтение/запись JSON" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;st